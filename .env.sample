# Application Configuration

PORT=8080 # The port on which the server will listen
NODE_ENV=development # The application environment (e.g., development, production, test)

# Database Configuration (TypeORM)

DB_TYPE=postgres # The type of database (e.g., postgres, mysql, sqlite)
DB_HOST=localhost # The database host
DB_PORT=5432 # The database port
DB_USERNAME=your_db_user # The database username
DB_PASSWORD=your_db_password # The database password
DB_NAME=your_database_name # The name of the database
DB_SYNCHRONIZE=true # Whether to automatically synchronize database schema (use true for development, false for production)
DB_LOGGING=true # Whether to log SQL queries to the console (use true for development, false for production)
DATABASE_URL=postgres://user:password@host:port/database # Optional: A full database connection URL (can override individual DB settings)

# Security Configuration

JWT_SECRET=your_jwt_secret_key_here # A secret key used for signing JWTs
JWT_EXPIRES_IN=1h # The expiration time for JWTs (e.g., 1h, 7d, 30m)

# CORS Configuration

CORS_ORIGIN=http://localhost:3000 # The origin allowed to access the API (e.g., your frontend URL)